# JobBot Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit .env or real secrets to version control.

# Database
DATABASE_URL=postgresql+asyncpg://jobbot:jobbot@localhost:5432/jobbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=changeme-use-a-long-random-string-in-production

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# File Storage
PDF_STORAGE_PATH=./data/pdfs

# Application
ENVIRONMENT=development
